{
  "name": "@job4me/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Database schema, client and migrations (ADR 0006)",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
