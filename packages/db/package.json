    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@job4me/config": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@job4me/tooling": "workspace:*",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
