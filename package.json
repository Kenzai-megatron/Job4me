{
  "name": "job4me",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "tsx scripts/dev.ts",
    "setup:dev": "tsx scripts/setup.ts dev",
    "setup:home": "tsx scripts/setup.ts home",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:compose": "tsx scripts/check-compose.ts",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "pnpm --filter @job4me/web build && pnpm --filter @job4me/e2e test:e2e",
    "test:e2e:stack": "tsx scripts/e2e-stack.ts",
    "job4me": "pnpm --filter @job4me/api run cli",
    "stack:up": "tsx scripts/stack.ts up",
    "stack:down": "tsx scripts/stack.ts down",
    "stack:logs": "tsx scripts/stack.ts logs",
    "stack:cli": "tsx scripts/stack.ts cli",
    "stack:backup": "tsx scripts/backup.ts",
    "stack:restore-test": "tsx scripts/restore-test.ts",
    "test:scripts": "vitest run --config scripts/vitest.config.ts",
    "probe:linkedin": "tsx scripts/probe-linkedin.ts",
    "geonames": "tsx scripts/geonames.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@job4me/collect": "workspace:*",
    "@job4me/config": "workspace:*",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "turbo": "2.11.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
