# Copy-free setup: `pnpm setup:dev` writes a real .env with random values.
# This file only documents the variables. Never commit a .env file.

JOB4ME_ENV=development

# PostgreSQL roles (ADR 0006): the owner applies migrations, the app role runs the application.
JOB4ME_DB_OWNER_PASSWORD=<random>
JOB4ME_DATABASE_OWNER_URL=postgres://job4me_owner:<random>@127.0.0.1:5432/job4me
JOB4ME_DATABASE_URL=postgres://job4me_app:<random>@127.0.0.1:5432/job4me

# 32 random bytes in base64 (ADR 0004). Keep a copy in your password manager.
JOB4ME_MASTER_KEY=<base64>

# Web Push keys (VAPID), base64url.
JOB4ME_VAPID_PUBLIC_KEY=<base64url>
JOB4ME_VAPID_PRIVATE_KEY=<base64url>

# Any secret can come from a file instead: JOB4ME_MASTER_KEY_FILE=/run/secrets/master_key
