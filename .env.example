# `pnpm setup:dev` (development) or `pnpm setup:home --origin https://job4me.<tailnet>.ts.net`
# writes the real .env. It only holds settings and paths: secrets stay as files in secrets/.

JOB4ME_ENV=development
JOB4ME_SECRETS_DIR=/path/to/job4me/secrets
JOB4ME_DB_HOST=127.0.0.1
JOB4ME_DB_OWNER_PASSWORD_FILE=/path/to/job4me/secrets/db_owner_password
JOB4ME_DB_APP_PASSWORD_FILE=/path/to/job4me/secrets/db_app_password
JOB4ME_DB_EXTRACTOR_PASSWORD_FILE=/path/to/job4me/secrets/db_extractor_password
JOB4ME_MASTER_KEY_FILE=/path/to/job4me/secrets/master_key
JOB4ME_IMPORT_KEY_FILE=/path/to/job4me/secrets/import_key
# Empty file: the AI is off. On the home machine only, write the Claude API key into it.
JOB4ME_ANTHROPIC_API_KEY_FILE=/path/to/job4me/secrets/anthropic_api_key
JOB4ME_FILES_DIR=/path/to/job4me/var/files
JOB4ME_VAPID_PUBLIC_KEY_FILE=/path/to/job4me/secrets/vapid_public_key
JOB4ME_VAPID_PRIVATE_KEY_FILE=/path/to/job4me/secrets/vapid_private_key

# Home machine only (setup:home):
# JOB4ME_PUBLIC_ORIGIN=https://job4me.<tailnet>.ts.net
# JOB4ME_RP_ID=job4me.<tailnet>.ts.net
# JOB4ME_PUSH_CONTACT=mailto:you@example.org
