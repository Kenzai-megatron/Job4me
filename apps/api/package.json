{
  "name": "@job4me/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "cli": "tsx src/cli/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.11",
    "@fastify/swagger": "9.9.5",
    "@job4me/config": "workspace:*",
    "@job4me/contracts": "workspace:*",
    "@job4me/db": "workspace:*",
    "@job4me/logger": "workspace:*",
    "@job4me/security": "workspace:*",
    "@simplewebauthn/server": "14.1.0",
    "fastify": "5.12.8",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "openapi-types": "12.1.3",
    "pg-boss": "12.38.2",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@job4me/tooling": "workspace:*",
    "@types/qrcode": "1.5.6",
    "tsup": "9.0.0"
