{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests",
    ":semanticCommitTypeAll(chore)"
  ],
  "timezone": "Europe/Brussels",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "7 days",
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "description": "Group every non-major update into one weekly pull request",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "non-major updates"
    },
    {
      "description": "Development tooling patches merge themselves once CI is green",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "TypeScript 7 waits for typescript-eslint support (ADR 0001)",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7",
      "minimumReleaseAge": "7 days"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions pinned in the workflows; a new version also needs its checksum, copied from the release",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Z0-9_]+_VERSION: (?<currentValue>\\S+)"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ]
}
